# =============================================================================
# RAG Pipeline Environment Configuration
# =============================================================================

# LLM Provider: "openai" or "anthropic"
RAG_LLM_PROVIDER=openai

# OpenAI-compatible backend (default). Keep this variable for either key type:
# - Native OpenAI: use an unqualified model, e.g. gpt-4o-mini.
# - OpenRouter: use a provider-qualified model, e.g. nvidia/nemotron-3-ultra-550b-a55b:free.
OPENAI_API_KEY=sk-your-openai-api-key
RAG_LLM_MODEL=gpt-4o-mini

# Anthropic (alternative backend, set RAG_LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# RAG_LLM_MODEL=claude-haiku-4-5

# Paths
RAG_DATA_DIR=data
RAG_CHROMA_PATH=data/chroma_db
# Recommended: run Chroma as its own server, which production uses too. Without these, Chroma
# runs inside the app. Start it first: chroma run --path data/chroma_server --port 8001
# RAG_CHROMA_HOST=127.0.0.1
# RAG_CHROMA_PORT=8001

# Optional shared query-embedding cache and cross-replica authentication limiter.
# Leave unset for the existing single-process in-memory behavior.
# RAG_REDIS_URL=redis://127.0.0.1:6379/0
RAG_REDIS_KEY_PREFIX=rag
RAG_REDIS_SOCKET_TIMEOUT_SECONDS=0.5
RAG_REDIS_EMBEDDING_CACHE_TTL_SECONDS=86400

# Chunking
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# Retrieval
RAG_TOP_K_RETRIEVAL=20
RAG_TOP_K_RERANK=5
RAG_TOP_K_FINAL=5
# Maximum chunks written per Chroma batch. Chroma's own lower limit wins.
RAG_INGEST_BATCH_SIZE=2000

# Hybrid Search (Phase 2)
RAG_HYBRID_ALPHA=0.6
# Max BM25 corpus file (MB) persisted/loaded; raise for very large corpora
RAG_BM25_MAX_INDEX_MB=500
# HNSW vector index. ef_search: higher = better recall (applied on startup).
# M / ef_construction only affect newly created collections.
RAG_HNSW_EF_SEARCH=200
RAG_HNSW_MAX_NEIGHBORS=16
RAG_HNSW_EF_CONSTRUCTION=100
# Overall limit for one query in seconds, including retries and self-healing (0 disables)
RAG_QUERY_TIMEOUT_SECONDS=180

# Re-ranker
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Evaluation (Phase 3) — also the self-healing verifier's faithfulness bar
RAG_FAITHFULNESS_THRESHOLD=0.7

# Self-healing (Phase 4) — verify, diagnose, repair, re-verify, or abstain.
# Off by default; clients can also opt in per request with "self_heal": true.

RAG_SELF_HEALING_ENABLED=false
RAG_MAX_HEALING_ATTEMPTS=3
RAG_VERIFIER_ENABLED=true
RAG_VERIFIER_LLM_MODEL=gpt-4o-mini
RAG_RELEVANCE_THRESHOLD=0.7
RAG_MIN_RETRIEVAL_SCORE=0.2
RAG_MIN_QUERY_COVERAGE=0.4
RAG_MIN_CITATION_SUPPORT=0.5

# Accounts and chat history, stored in SQLite. Keep this on a local disk, not a network share.
# RAG_CHAT_DB_PATH=data/chat.db
# Turn off once accounts exist. `python -m scripts.manage_users create <name>` still works.
RAG_ALLOW_SIGNUP=true
RAG_SESSION_TTL_HOURS=720
# Turn on when a proxy terminates TLS and forwards plain HTTP to this app.
RAG_SESSION_COOKIE_SECURE=false
# Sign-ins and registrations allowed per address, before it has to wait.
RAG_AUTH_IP_MAX_ATTEMPTS=20
RAG_AUTH_IP_WINDOW_SECONDS=300
# Behind a proxy: set FORWARDED_ALLOW_IPS to the proxy's address, or everyone shares one limit.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Let /ingest's "reset" delete every user's documents. Leave off in production.
RAG_ALLOW_STORE_RESET=false

# How far to trust each source, 0-100, by folder inside RAG_DATA_DIR (longest match wins).
# RAG_SOURCE_AUTHORITY={"policies": 90, "uploads": 30}
RAG_DEFAULT_SOURCE_AUTHORITY=50
# Collection and reader roles per folder (longest match wins). Lowercase names.
# RAG_SOURCE_COLLECTIONS={"policies/hr": "hr-policies"}
# RAG_SOURCE_ROLES={"policies/hr": ["hr", "managers"]}

# Screening before indexing. Credentials are always worth redacting; personal data and
# instruction-like text are flagged on each chunk unless set otherwise.
RAG_REDACT_CREDENTIALS=true
RAG_PII_MODE=flag
RAG_INJECTION_MODE=flag
# Sources at or above this authority are never marked suspect (e.g. a security team's docs).
# RAG_INJECTION_TRUSTED_AUTHORITY=90
# Redact credentials and personal data from answers, citations, and /chunks on the way out.
RAG_REDACT_ANSWERS=false

# Load models and search indexes before accepting requests. The reranker costs memory.
RAG_WARM_UP_ON_START=true
RAG_WARM_UP_RERANKER=true

# Logging
RAG_LOG_LEVEL=INFO
# Example for production: RAG_CORS_ORIGINS=https://myapp.example.com,https://admin.example.com
RAG_CORS_ORIGINS=*

# Optional API key — set to require "Authorization: Bearer <key>" on all requests.
RAG_API_KEY=

# =============================================================================
# Monitoring (Phase 3) — all optional
# =============================================================================

MONITOR_ENABLED=false
MONITOR_LANGFUSE_SECRET_KEY=
MONITOR_LANGFUSE_PUBLIC_KEY=
MONITOR_LANGFUSE_HOST=https://cloud.langfuse.com
MONITOR_OTEL_SERVICE_NAME=rag-pipeline
MONITOR_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
MONITOR_CIRCUIT_BREAKER_THRESHOLD=3
MONITOR_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
